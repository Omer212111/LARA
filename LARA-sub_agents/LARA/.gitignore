# Environments
.env
.venv/
venv/
env/
venv_linux/

# Python caching
__pycache__/
*.pyc

# IDEs
.idea/
.vscode/

# LARA Project Exclusions
experiments/
trace_output.json
*.rar
*.txt
dashboard.html

# AppWorld task data — large; restored from git history / downloaded locally, never commit.
# (data/tasks here is a junction to <repo-root>/data/tasks.)
data/tasks/
*_run.log
*.report.json
# AppWorld base template DBs (135MB) — restored from git history, never commit
data/base_dbs/

# Capability-study artifacts — raw run logs are large (~10MB) and regenerable
# from the pinned slices in analysis/slices.json. The distilled outputs
# (*.report.md, *.results.json, *.probe.json) ARE committed.
analysis/runs/**/*.log
analysis/runs/**/*.run_log.html
# Timestamped docx backups written by append_docx_log.py / rewrite_docx_sections.py
*.backup-*.docx

# Run artifacts and internal working docs — not part of the submitted agent.
# Kept on disk, just not tracked: they are outputs and process notes, and a
# reviewer landing here should see the code, not a run log.
run_log.html
LARA Agent Log.html
LARA Agent Log.pdf
RUN_TEST_CHALLENGE.md
SUBMIT_LEADERBOARD.md
*.docx
